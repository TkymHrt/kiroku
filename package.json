  "trustedDependencies": [
    "esbuild",
    "sharp",
    "workerd"
  ],
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.4",
    "@modelcontextprotocol/inspector": "^2.11.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.6",
    "miniflare": "^4.20260730.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0",
    "vitest": "5.0.5",
    "void": "1.2.1"
  },
  "name": "kiroku",
  "scripts": {
    "dev": "vp dev",
    "build": "vp run cached-build",
    "build:fresh": "vp run --no-cache cached-build",
    "prepare": "void prepare",
    "typecheck": "void prepare && vp check --no-fmt --no-lint",
    "test": "vp test run",
    "test:e2e": "playwright test",
    "test:workers": "vp test run --config server/vitest.workers.config.ts",
    "lint": "vp lint --deny-warnings",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check": "void prepare && vp check --deny-warnings && bun run test && bun run test:workers && bun run build"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vitest": "5.0.5"
  }
}
