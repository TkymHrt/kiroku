{
  "extends": "./.void/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["void/env", "vite/client"]
  },
  "include": [
    "src",
    "pages",
    "routes",
    "middleware",
    "crons",
    "queues",
    "db",
    "server",
    "env.ts",
    "worker-configuration.d.ts"
  ]
}
